@startuml components
title Ports and adapters (core never imports adapters)
skinparam componentStyle rectangle

package "factory.cli" { [factory CLI] as CLI }
package "factory.config" {
  [loader + schema + validate] as CFG
  [registry (alias | module:Class)] as REG
}
package "factory.features" { [feature table + dependency check] as FEAT }
package "factory.core" {
  [pipeline / state machine] as PIPE
  [readiness checklist] as READY
  [claim + push library] as PUSH
  [dedupe + intake service] as INTAKE
  [budget wrapper] as BUDGET
  [workspace isolator\n(policy applied, history replaced)] as ISO
  [model gateway (loopback)\nopenai_chat | anthropic_messages] as GW
  [harness: builtin tool loop] as LOOP
  [harness: command (any CLI agent)] as CMD
}
package "bring your own" {
  [external agent CLI] as EXT
}
package "factory.access" { [PolicyAccessGuard] as GUARD }
package "factory.skills.base" { [no-proprietary-files\n(+ global rules)] as SKILLS }

package "factory.ports (Protocols)" {
  interface TicketSystem
  interface GitHost
  interface Mailbox
  interface ModelProvider
  interface AgentHarness
  interface Sandbox
  interface AccessGuard
  interface Notifier
  interface Monitor
  interface "TraceWriter / TraceReader" as TS
  interface Accounting
  interface StateStore
  interface "Clock / IdSource" as CLK
}

package "factory.adapters" {
  package fake { [in-memory fakes\n(first-class, contract-tested)] as FAKES }
  package jira { [JiraTicketSystem] as JIRA }
  package gitlab { [GitlabGitHost (git argv)] as GITLAB }
  package mail { [ImapSmtpMailbox] as MAIL }
  package models { [OpenAICompatible / Replay] as MODELS }
}

CLI --> CFG
CLI --> FEAT
CFG --> REG
REG ..> FAKES : imports only\nselected + enabled
REG ..> JIRA
REG ..> GITLAB
REG ..> MAIL
REG ..> MODELS
CLI --> PIPE
PIPE --> READY
PIPE --> PUSH
PIPE --> INTAKE
PIPE --> ISO
ISO --> AccessGuard
PIPE --> AgentHarness : run(task)
LOOP ..|> AgentHarness
CMD ..|> AgentHarness
CMD --> EXT : argv in Sandbox
EXT --> GW : only model route
LOOP --> GW
LOOP --> AccessGuard
PIPE --> SKILLS : rendered into\ninstructions file
GW --> BUDGET
BUDGET --> ModelProvider
BUDGET --> Accounting
PUSH --> TicketSystem
PUSH --> GitHost
INTAKE --> Mailbox
INTAKE --> Monitor
PIPE --> Sandbox
PIPE --> Notifier
PIPE --> TS
PIPE --> StateStore
PIPE --> CLK
GUARD ..|> AccessGuard
FAKES ..|> TicketSystem
JIRA ..|> TicketSystem
GITLAB ..|> GitHost
MAIL ..|> Mailbox
MODELS ..|> ModelProvider
note bottom of MODELS : any number of named providers;\nstages pick provider + model
@enduml
